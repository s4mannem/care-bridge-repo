# Copy to api/.env (gitignored). The repo-root .env is read first, so shared values
# (BQ_PROJECT, GOOGLE_CLOUD_PROJECT) can live there instead.
CAREBRIDGE_ENV=dev
CAREBRIDGE_LOG_LEVEL=INFO
CAREBRIDGE_AGENT_ENGINE=stub          # stub | adk
CAREBRIDGE_PLAN_TIMEOUT_S=120
# CAREBRIDGE_CORS_ORIGINS=["https://planner.example.org"]
BQ_PROJECT=your-gcp-project
BQ_DATASET=a4i_health
