# Copy to terraform.tfvars (gitignored) or let bootstrap.sh write it.
project_id = "your-gcp-project"
region     = "us-central1"
prefix     = "carebridge"

# Leave empty until the GitHub connection exists; everything but triggers still applies.
github_connection = ""
github_repo_uri   = "https://github.com/s4mannem/care-bridge-repo.git"
main_branch       = "main"

# Hashed Cloud Run URLs of the UI that may use the Google Maps key (infra/maps.tf).
# maps_extra_referrers = ["https://carebridge-ui-dev-<hash>-uc.a.run.app/*"]
