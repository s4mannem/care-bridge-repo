# Rendered at container start by the nginx image's envsubst step.
# Only env vars that are set get substituted, so nginx's own $vars are safe.
server {
    listen ${PORT};
    root /usr/share/nginx/html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=60s ipv6=off;

    # Same-origin API: no CORS, no API URL compiled into the app.
    # ^~ so the static-asset regex below never captures an API path.
    location ^~ /v1/ {
        set $api ${API_URL};
        proxy_pass $api;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The app waits 130 s for a plan; the API gives up at 120 s.
        proxy_read_timeout 140s;
    }

    # Loads the Maps JavaScript API with the key from GOOGLE_MAPS_KEY (Secret
    # Manager on Cloud Run), so the key is never compiled into the app. With no
    # key this is an empty script and the app falls back to OpenStreetMap tiles.
    location = /gmaps.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache";
        set $maps_key "${GOOGLE_MAPS_KEY}";
        if ($maps_key = "") {
            return 200 "// No GOOGLE_MAPS_KEY: the planner map uses OpenStreetMap.\n";
        }
        return 200 "document.write('<script src=\"https://maps.googleapis.com/maps/api/js?key=$maps_key&v=weekly\"><\\/script>');\n";
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Hashed Flutter assets can be cached; index.html and the bootstrap must not be.
    location ~* \.(?:js|css|wasm|png|jpg|svg|ttf|otf|woff2?|json)$ {
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
